          "raw": "{{baseUrl}}/api/contact",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contact"]
        },
        "description": "Fetches all contact enquiries stored in MongoDB Atlas sorted newest first."
      },
      "response": []
    },
