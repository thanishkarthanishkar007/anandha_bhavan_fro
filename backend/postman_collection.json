        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"S. Venkataraman\",\n  \"phone\": \"+91 95975 35555\",\n  \"email\": \"srenewaanandabavan@gmail.com\",\n  \"guests\": \"4 Guests\",\n  \"date\": \"2026-09-28\",\n  \"timeSlot\": \"Lunch (12:30 PM)\",\n  \"specialRequests\": \"Traditional plantain leaf meal for family feast. Pure vegetarian.\"\n}"
