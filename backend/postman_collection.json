          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Checks the operational health of the FastAPI backend, MongoDB Atlas cluster connection, and Resend email status."
      },
      "response": []
    },
    {
